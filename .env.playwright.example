# Copy this file to .env.playwright and set BASE_URL. Set SESSION_COOKIE on the
# first run or after the saved session expires.
#
# URL of a running Pacearr instance.
BASE_URL=http://localhost:9302
#
# The value of the pacearr_session cookie from an authenticated browser session.
# It is only needed on the first run, or when the saved session expires.
SESSION_COOKIE=
